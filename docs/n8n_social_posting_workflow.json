        ],
        [
          {
            "node": "TikTok Creator Post",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "X (Twitter) Tweet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "YouTube Video Upload": {
      "main": [
        [
          {
