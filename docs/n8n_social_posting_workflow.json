            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Instagram Reels Container": {
      "main": [
        [
          {
            "node": "Live Dispatch Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "TikTok Creator Post": {
      "main": [
        [
          {
            "node": "Live Dispatch Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "X (Twitter) Tweet": {
